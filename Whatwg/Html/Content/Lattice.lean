/-! ## Separation -/

/-- `notag` admits no tag. -/
theorem notag_false (t : Tag) : Sets.notag t = false := rfl

/-- `ContentSet.notag` admits no tag. -/
theorem contains_notag_false (t : Tag) : ContentSet.contains .notag t = false := rfl

/-- Every void element row carries the empty content set. Stated over the 111
element rows, so both the `table` and the `tablex` row are covered. -/
theorem void_content_notag :
    ∀ e ∈ elements, (Element.tag e).isVoid = true → Element.content e = some .notag := by
  intro e he hv
  have h := forall_elements_of_all
    (fun e => !(Element.tag e).isVoid || (Element.content e == some ContentSet.notag))
    (by decide +kernel) e he
  rw [hv] at h
  simpa using h

/-- The same fact through `Tag.element?`, which is the form the typed tree
uses: a void tag resolves to the empty content set. -/
theorem void_element_content_notag :
    ∀ t : Tag, t.isVoid = true → (Tag.element? t).bind Element.content = some .notag := by
  intro t hv
  have h := forall_tag_of_all
    (fun t => !t.isVoid || ((Tag.element? t).bind Element.content == some ContentSet.notag))
    (by decide +kernel) t
  rw [hv] at h
  simpa using h

/-- Every void tag has an element constructor. -/
theorem void_element_isSome : ∀ t : Tag, t.isVoid = true → (Tag.element? t).isSome = true := by
  intro t hv
  have h := forall_tag_of_all (fun t => !t.isVoid || (Tag.element? t).isSome) (by decide +kernel) t
  rw [hv] at h
  simpa using h

/-- The converse of `void_content_notag` fails. Two element rows are not void
and still carry `notag`: `datalist` (whose TyXML constructor takes either
phrasing children or `option` children, and whose plain content set is
therefore empty) and `menu`. This theorem records that such a row exists;
`Whatwg.Html.Content.Divergence` owns the reading of it. -/
theorem exists_nonvoid_notag_content :
    elements.any (fun e =>
      !(Element.tag e).isVoid && (Element.content e == some ContentSet.notag)) = true := by
  decide

/-! ## Boolean decompositions

One exclusion predicate per distinct difference, then one decomposition
theorem per `_without_` family. The predicates are the computed differences,
not TyXML type names: `Excluded.flow5Interactive` is exactly
`flow5 \ flow5_without_interactive` and nothing else. -/

namespace Excluded

/-- The empty exclusion, for the four `_without_` sets that exclude nothing. -/
def nothing : Tag → Bool := fun _ => false

/-- `core_flow5 \ core_flow5_without_interactive`. -/
def coreFlow5Interactive : Tag → Bool
  | .details | .embed | .iframe | .img_interactive => true
  | _ => false

/-- `core_phrasing \ core_phrasing_without_interactive`. -/
def corePhrasingInteractive : Tag → Bool
  | .button | .embed | .iframe | .img_interactive | .input | .keygen
  | .label | .output | .select | .textarea => true
  | _ => false

/-- `flow5 \ flow5_without_interactive`. Wider than
`coreFlow5Interactive` by the four transparent interactive variants `A`,
`Audio_interactive`, `Object_interactive`, `Video_interactive`, and narrower
than `corePhrasingInteractive`, which excludes the form controls. -/
def flow5Interactive : Tag → Bool
  | .a | .audio_interactive | .details | .embed | .iframe | .img_interactive
  | .object_interactive | .video_interactive => true
  | _ => false

/-- `flow5 \ flow5_without_interactive_header_footer`: `flow5Interactive`
together with `Footer` and `Header`. -/
def flow5InteractiveHeaderFooter : Tag → Bool
  | .a | .audio_interactive | .details | .embed | .footer | .header | .iframe
  | .img_interactive | .object_interactive | .video_interactive => true
  | _ => false

/-- `phrasing \ phrasing_without_interactive`: `flow5Interactive` without
`Details` and with the six form controls and `Label`. -/
def phrasingInteractive : Tag → Bool
  | .a | .audio_interactive | .button | .embed | .iframe | .img_interactive
  | .input | .keygen | .label | .object_interactive | .output | .select
  | .textarea | .video_interactive => true
  | _ => false

/-- `labelable \ labelable_without_interactive`. -/
def labelableInteractive : Tag → Bool
  | .button | .input | .keygen | .output | .select | .textarea => true
  | _ => false

/-- The media exclusion, shared by `flow5_without_media`,
`phrasing_without_media` and `transparent_without_media`. -/
def media : Tag → Bool
  | .audio | .audio_interactive | .video | .video_interactive => true
  | _ => false

/-- The noscript exclusion, shared by `flow5_without_noscript` and
`transparent_without_noscript`. It is *not* the exclusion of
`phrasing_without_noscript`: see `phrasingNoscript`. -/
def noscript : Tag → Bool
  | .noscript => true
  | _ => false

/-- `flow5 \ flow5_without_form`. -/
def form : Tag → Bool
  | .form => true
  | _ => false

/-- `flow5 \ flow5_without_header_footer`. -/
def headerFooter : Tag → Bool
  | .footer | .header => true
  | _ => false

/-- `flow5 \ flow5_without_table`. -/
def table : Tag → Bool
  | .table => true
  | _ => false

/-- `flow5 \ flow5_without_sectioning_heading_header_footer`. -/
def sectioningHeadingHeaderFooter : Tag → Bool
  | .article | .aside | .footer | .h1 | .h2 | .h3 | .h4 | .h5 | .h6
  | .header | .hgroup | .nav | .«section» => true
  | _ => false

/-- `flow5 \ flow5_without_sectioning_heading_header_footer_address`. -/
def sectioningHeadingHeaderFooterAddress : Tag → Bool
  | .address | .article | .aside | .footer | .h1 | .h2 | .h3 | .h4 | .h5 | .h6
  | .header | .hgroup | .nav | .«section» => true
  | _ => false

/-- `phrasing \ phrasing_without_dfn`. `Embed`, `Iframe` and `Svg` are
excluded along with `Dfn`: TyXML's `phrasing_without_dfn` is an explicit
inclusion list that omits them. -/
def phrasingDfn : Tag → Bool
  | .dfn | .embed | .iframe | .svg => true
  | _ => false

/-- `phrasing \ phrasing_without_label`, with the same three extra tags. -/
def phrasingLabel : Tag → Bool
  | .embed | .iframe | .label | .svg => true
  | _ => false

/-- `phrasing \ phrasing_without_meter`, with the same three extra tags. -/
def phrasingMeter : Tag → Bool
  | .embed | .iframe | .meter | .svg => true
  | _ => false

/-- `phrasing \ phrasing_without_progress`, with the same three extra tags. -/
def phrasingProgress : Tag → Bool
  | .embed | .iframe | .progress | .svg => true
  | _ => false

/-- `phrasing \ phrasing_without_time`, with the same three extra tags. -/
def phrasingTime : Tag → Bool
  | .embed | .iframe | .svg | .time => true
  | _ => false

/-- `phrasing \ phrasing_without_noscript`: 44 of the 55 phrasing tags.
TyXML defines `phrasing_without_noscript` as the transparent row alone, so
everything outside that row is excluded, not just `Noscript`. -/
def phrasingNoscript : Tag → Bool
  | .abbr | .b | .bdo | .br | .button | .cite | .code | .command
  | .datalist | .dfn | .em | .embed | .i | .iframe | .img | .img_interactive
  | .input | .kbd | .keygen | .label | .mark | .meter | .noscript | .output
  | .pcdata | .picture | .progress | .q | .ruby | .samp | .script | .select
  | .small | .span | .strong | .sub | .sup | .svg | .template | .textarea
  | .time | .u | .var | .wbr => true
  | _ => false

/-- `transparent \ transparent_without_interactive`. -/
def transparentInteractive : Tag → Bool
  | .a | .audio_interactive | .object_interactive | .video_interactive => true
  | _ => false

end Excluded

