import Whatwg.Html.Schema

/-!
# Whatwg.Html.Content.Lattice

The inclusion and separation lemmas over the generated content sets (node L1
and node L2 of the H3 proof graph in `docs/HTML-PACKAGE-PLAN.md`, ruling
HP-6), together with the finite-enumeration infrastructure every later
content-model proof reuses.

Route. `Tag` and `ContentSet` are finite enumerations and every membership
function generated by slice H2 is constructor dispatch, so a universally
quantified statement over tags is decided by one `List.all` over `Tag.all`
and one appeal to `Tag.mem_all`. `forall_tag_of_all` below is that appeal;
every lemma in this module is `... (by decide +kernel)` through it. No tactic outside
the ceiling of `Whatwg/AGENTS.md` appears here.

What the boolean decompositions are for. TyXML writes each `x_without_y`
content set as its own explicit inclusion list rather than as a subtraction
from `x`, so the name of a set is not evidence about its members. This module
therefore computes the actual difference `x \ x_without_y` from the generated
data, names it as an exclusion predicate under `Excluded`, and states the
decomposition `x_without_y t = (x t && !excluded t)` as a theorem. Where the
difference is not what the family name suggests, the theorem is true to the
data and its docstring lists the exact tags. The observed departures at this
pin are:

- `core_flow5_without_media`, `core_flow5_without_noscript`,
  `core_phrasing_without_media` and `core_phrasing_without_noscript` exclude
  nothing at all: each is equal to its base as a membership function.
- `phrasing_without_noscript` is not `phrasing` minus `noscript`. TyXML
  defines it as the transparent row alone, so it has 11 members and is equal
  to `transparent_without_noscript`; 44 of the 55 members of `phrasing` are
  absent from it.
- `core_phrasing_without_noscript` is consequently *not* inside
  `phrasing_without_noscript`: the two sets are disjoint.
- `phrasing_without_dfn`, `phrasing_without_label`, `phrasing_without_meter`,
  `phrasing_without_progress` and `phrasing_without_time` each drop `Embed`,
  `Iframe` and `Svg` in addition to the tag their name mentions.
- `flow5_without_interactive` drops `Details`, `Embed`, `Iframe` and the
  interactive transparent variants along with `A`, while
  `core_flow5_without_interactive` drops only `Details`, `Embed`, `Iframe`
  and `Img_interactive`: the two families exclude different tags, so no
  single interactive predicate serves both.
- `metadata_without_title` has no base set here at all: TyXML's `metadata`
  type is unreachable from any element content model at this pin, so slice
  H2 did not project it and no `metadata_without_title ⊆ metadata` statement
  can be made.

Nothing in this module is a claim about the HTML Standard. Every statement is
about the TyXML 4.6.0 projection sealed under `vendor/tyxml-d2916535/`; the
places where that projection departs from the standard are the business of
`Whatwg.Html.Content.Divergence`.
-/

namespace Whatwg.Html.Schema

/-! ## Finite enumeration

The two enumerations and the reflection principle over them. -/

/-- Every tag is a member of `Tag.all`. -/
theorem Tag.mem_all (t : Tag) : t ∈ Tag.all := by
  cases t <;> decide

/-- Every content set is a member of `ContentSet.all`. -/
theorem ContentSet.mem_all (c : ContentSet) : c ∈ ContentSet.all := by
  cases c <;> decide

/-- `Tag.all` enumerates the 115 tags of the projection. -/
theorem Tag.all_length : Tag.all.length = 115 := by decide

/-- `ContentSet.all` enumerates the 69 named content sets of the projection. -/
theorem ContentSet.all_length : ContentSet.all.length = 69 := by decide

/-- `Tag.all` lists no tag twice, so with `Tag.mem_all` and `Tag.all_length`
it is an enumeration of the tag universe without repetition. -/
theorem Tag.all_nodup : Tag.all.Nodup := by decide

/-- `ContentSet.all` lists no content set twice. -/
theorem ContentSet.all_nodup : ContentSet.all.Nodup := by decide

/-- Reflection over tags: a boolean predicate that `List.all` accepts on
`Tag.all` holds at every tag. -/
theorem forall_tag_of_all (p : Tag → Bool) (h : Tag.all.all p = true) :
    ∀ t : Tag, p t = true :=
  fun t => List.all_eq_true.mp h t (Tag.mem_all t)

/-- The same reflection at `Prop`, for a decidable predicate on tags. -/
theorem forall_tag_of_decide (p : Tag → Prop) [DecidablePred p]
    (h : Tag.all.all (fun t => decide (p t)) = true) : ∀ t : Tag, p t :=
  fun t => of_decide_eq_true (forall_tag_of_all (fun t => decide (p t)) h t)

/-- Reflection over content sets. -/
theorem forall_contentSet_of_all (p : ContentSet → Bool)
    (h : ContentSet.all.all p = true) : ∀ c : ContentSet, p c = true :=
  fun c => List.all_eq_true.mp h c (ContentSet.mem_all c)

/-- Reflection over the product of the two enumerations, as the transparent
lemmas of `Whatwg.Html.Content.Transparent` need it. -/
theorem forall_contentSet_tag_of_all (p : ContentSet → Tag → Bool)
    (h : ContentSet.all.all (fun c => Tag.all.all (p c)) = true) :
    ∀ (c : ContentSet) (t : Tag), p c t = true :=
  fun c t => forall_tag_of_all (p c) (forall_contentSet_of_all _ h c) t

/-- Reflection over the element rows. -/
theorem forall_elements_of_all (p : Element → Bool) (h : elements.all p = true) :
    ∀ e ∈ elements, p e = true :=
  fun e he => List.all_eq_true.mp h e he

end Whatwg.Html.Schema

