/-! ## Inclusion

`SubsetOf a b` is pointwise implication of two membership functions, and
`subsetOf_of_all` decides it by one `List.all` over the 115 tags. -/

/-- Pointwise inclusion of two tag-membership functions: every tag `a`
accepts, `b` accepts. -/
def SubsetOf (a b : Tag → Bool) : Prop := ∀ t : Tag, a t = true → b t = true

/-- Pointwise disjointness of two tag-membership functions. -/
def DisjointFrom (a b : Tag → Bool) : Prop := ∀ t : Tag, a t = true → b t = false

/-- Inclusion by reflection over `Tag.all`. -/
theorem subsetOf_of_all {a b : Tag → Bool}
    (h : Tag.all.all (fun t => !a t || b t) = true) : SubsetOf a b := by
  intro t ht
  have hb := forall_tag_of_all (fun t => !a t || b t) h t
  rw [ht] at hb
  simpa using hb

/-- Disjointness by reflection over `Tag.all`. -/
theorem disjointFrom_of_all {a b : Tag → Bool}
    (h : Tag.all.all (fun t => !a t || !b t) = true) : DisjointFrom a b := by
  intro t ht
  have hb := forall_tag_of_all (fun t => !a t || !b t) h t
  rw [ht] at hb
  simpa using hb

/-- Equality of two membership functions by reflection over `Tag.all`. -/
theorem eq_of_all {a b : Tag → Bool}
    (h : Tag.all.all (fun t => a t == b t) = true) : ∀ t : Tag, a t = b t :=
  fun t => eq_of_beq (forall_tag_of_all (fun t => a t == b t) h t)

